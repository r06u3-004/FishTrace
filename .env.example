FISHTRACE_ENVIRONMENT=development
FISHTRACE_DEBUG=false
FISHTRACE_SECRET_KEY=replace-with-a-long-random-value-before-deployment
FISHTRACE_DATABASE_URL=postgresql+psycopg://fishtrace@127.0.0.1:55432/fishtrace
FISHTRACE_CORS_ORIGINS=http://127.0.0.1:5173
FISHTRACE_CORS_ALLOW_CREDENTIALS=false
FISHTRACE_CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
FISHTRACE_CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept
FISHTRACE_UPLOAD_MAX_BYTES=26214400
FISHTRACE_EVIDENCE_DIR=./backend/evidence
FISHTRACE_REPORT_DIR=./reports
FISHTRACE_ACCESS_TOKEN_TTL_MINUTES=480
